# ============================================================
# FitGenie AI Backend — Environment Variables
# Copy this file to `.env` for local development and fill in
# real values. NEVER commit a real `.env` file to version control.
# In production (AWS App Runner), set these as environment
# variables / secrets in the App Runner service configuration —
# do not bake them into the Docker image.
# ============================================================

# --- App metadata ---
APP_NAME=FitGenie AI Backend
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS ---
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Gemini (Google GenAI SDK) ---
# Required. Get a key at https://aistudio.google.com/apikey
# In production, inject this via AWS Secrets Manager / App Runner secrets,
# never hardcode it here or in source control.
GEMINI_API_KEY=your-google-genai-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE_PLAN=0.4
GEMINI_TEMPERATURE_CHAT=0.6
GEMINI_MAX_TOKENS_PLAN=4096
GEMINI_MAX_TOKENS_CHAT=1024
GEMINI_REQUEST_TIMEOUT=60

# --- Logging ---
LOG_LEVEL=INFO
